# no trailing slash: a `node_modules/` pattern matches a DIRECTORY only, and
# a local test run may leave a node_modules SYMLINK (pointing at a global
# install of playwright) — which git sees as a file, so the slashed form let
# `git add -A` commit it.
node_modules

# Throwaway probe scripts a local run may leave behind (they must live in the
# repo root so node_modules resolves, which is why they are ignored here).
_probe.mjs
_t[0-9]*.mjs

# Isolated git worktrees a review run creates for its agents (checkouts of
# this repository, inside this repository). Tooling scratch, removed when the
# run ends — never content.
.claude/worktrees/

# The emulator suite writes its own log beside the repository root when
# _functions/test/forum-emulator.mjs is run locally. Tooling scratch, and the
# run that produced it is the ground truth rather than the file.
firestore-debug.log
ui-debug.log

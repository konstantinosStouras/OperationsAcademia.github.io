{
  "name": "oa-functions",
  "description": "Operations Academia Cloud Functions: instant publish, the university-visit resolver, the e-mail verification mailer, and the forum",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/secret-manager": "^7.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  },
  "scripts": {
    "test:emulator": "firebase emulators:exec --project demo-oa-forum --only auth,firestore,functions \"node test/forum-emulator.mjs\""
  }
}

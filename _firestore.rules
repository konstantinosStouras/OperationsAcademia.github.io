rules_version = '2';

// ---------------------------------------------------------------------------
// Operations Academia — Firestore security rules.
//
// DEPLOY THESE BEFORE ANNOUNCING ANYTHING. Until they are published, every
// write below is refused and the site's forms report that they are not
// switched on yet (which is the state the code ships in).
//
//     firebase deploy --only firestore:rules --project <project-id>
//
// The governing idea, taken from /lit/: the browser is never trusted with
// anything that decides what gets published. A poster may CREATE a submission
// and may edit or withdraw their OWN, but they cannot set `status` to anything
// except 'queued'/'withdrawn', cannot write someone else's uid onto it, and
// cannot mark it featured. The scheduled build runs with the Admin SDK, which
// bypasses these rules, and re-validates every field again before it reaches a
// served file (v2/_scraper/jobs-model.mjs).
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The maintainer. Keep in sync with ADMIN_EMAIL in v2/assets/oa-firebase.js
    // (that one only decides whether an admin panel is DRAWN; this one is the
    // actual authorisation).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kstouras@gmail.com';
    }

    function str(field, maxLen) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= maxLen);
    }

    function list(field, maxItems) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is list
            && request.resource.data[field].size() <= maxItems);
    }

    // ---------------------------------------------------------------- jobs

    match /jobSubmissions/{id} {

      function shapeOk() {
        return str('institution', 200) && str('department', 260)
            // school and unit are what the form now asks for separately;
            // `department` is the line they are joined into, and is still what
            // every posting made before the split carries.
            && str('school', 200)      && str('unit', 200)
            && str('country', 80)      && str('type', 40)
            && str('applyByDate', 20)  && str('applyByNote', 400)
            && str('comments', 1500)   && str('postedAtUrl', 600)
            && str('adUrl', 600)       && str('ref', 60)
            && str('firstName', 100)   && str('lastName', 100)
            && str('email', 200)       && str('chairName', 160)
            && str('chairEmail', 200)  && str('note', 1500)
            && str('source', 40)       && str('authEmail', 200)
            // the uploaded advert, waiting in Storage for the build to file
            // it into Drive (oa-jobform.js / build-jobs.mjs)
            && str('adUploadPath', 400) && str('adUploadName', 200)
            && str('adUploadType', 100)
            && list('levels', 8)       && list('characteristics', 12)
            && request.resource.data.year is int
            && request.resource.data.year >= 2000
            && request.resource.data.year <= 2100
            // the page's sort key; the build derives it from createdAt and
            // ignores anything on the document — refuse the key so a poster
            // cannot even try to pin their card to the top
            && !('postedOn' in request.resource.data)
            // owner is derived from uid by the build, never client-supplied
            && !('owner' in request.resource.data);
      }

      /* A poster cannot promote their own posting. On CREATE that is simply
         "no featured field". On UPDATE it has to be "featured is UNCHANGED":
         update() merges, so an already-featured posting carries the field into
         every request, and refusing the field outright would make the one
         featured posting the only one its owner could never correct. */
      function featuredUnchanged() {
        return ('featured' in request.resource.data) == ('featured' in resource.data)
            && (!('featured' in request.resource.data)
                || request.resource.data.featured == resource.data.featured);
      }

      // Anyone signed in may post. Identity is pinned to the caller and the
      // status is pinned to 'queued' — the build decides what is published.
      // createdAt is the server clock, never a client-typed value (create
      // only — on an update request.resource.data carries the EXISTING stamp,
      // which rightly stays put): the build treats it as trustworthy (it
      // becomes addedAt, the e-mail alerts' cursor), so a bogus 1e16 or a
      // back-dated value must not exist at all.
      // The key ceiling must clear what the form actually writes: 27 keys
      // always (collect() + ref/uid/authEmail/status/source/createdAt) and 4
      // more when the advert is UPLOADED rather than linked (adUploadPath/
      // Name/Type/Size) — 31 in all. At the old ceiling of 30 exactly the
      // upload case was refused as permission-denied while a link-only
      // posting sailed through. selftest.mjs pins this arithmetic against
      // the form source, so a new field fails the build, not the poster.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'queued'
                    && request.resource.data.createdAt == request.time
                    && shapeOk()
                    && !('featured' in request.resource.data)
                    && request.resource.data.keys().size() <= 34;

      // A poster may read, correct and withdraw their own posting.
      allow read: if isOwner(resource.data.uid) || isAdmin();

      // A poster correcting or withdrawing their own posting. `status` back to
      // 'queued' is what a correction does — including to a posting that had
      // been withdrawn, which is how one is put back.
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.status in ['queued', 'withdrawn']
                    && featuredUnchanged()
                    && shapeOk();

      // MERGING TWO ACCOUNTS hands a posting over to the account its owner is
      // keeping. A posting is a top-level document owned by a `uid` field, so
      // without this the rule above (which pins that field) would strand every
      // posting of a merged-away account: unwithdrawable, uncorrectable, owned
      // by a sign-in that no longer exists.
      //
      // Only the CURRENT owner may hand one over, and `diff().affectedKeys()`
      // pins everything else — the posting itself cannot be edited under cover
      // of a merge, not even by its owner, and `featured` is as untouchable
      // here as it is above. `mergedFrom` records where it came from, so the
      // change is visible in the document rather than inferred.
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['uid', 'mergedFrom', 'mergedAt'])
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() >= 10
                    && request.resource.data.uid != resource.data.uid
                    && request.resource.data.mergedFrom == request.auth.uid;

      allow delete: if isAdmin();

      // The maintainer can hide a posting, feature one, or fix a typo.
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------- candidates

    /* A job-market candidate's own profile: the same lifecycle as a job
       posting (create queued -> the build publishes -> correct or withdraw),
       plus two optional uploads (CV, research summary) that land in Storage
       (see _storage.rules, kind 'candidates') and are filed into Drive by the
       build, exactly like a job advert. `email` is published ONLY when
       `emailPublic` is true — the old sheet published every address, which is
       the disclosure the rebuild retires. */
    match /candidateSubmissions/{id} {

      function candShapeOk() {
        return str('first', 100)      && str('last', 100)
            && str('affiliation', 220) && str('position', 160)
            && str('cvUrl', 600)       && str('rsUrl', 600)
            && str('webUrl', 600)      && str('email', 200)
            && str('note', 1500)       && str('source', 40)
            && str('authEmail', 200)   && str('ref', 60)
            && str('cvUploadPath', 400) && str('cvUploadName', 200)
            && str('cvUploadType', 100)
            && str('rsUploadPath', 400) && str('rsUploadName', 200)
            && str('rsUploadType', 100)
            && list('researchAreas', 10) && list('informsDays', 10)
            && (!('emailPublic' in request.resource.data)
                || request.resource.data.emailPublic is bool)
            && request.resource.data.year is int
            && request.resource.data.year >= 2000
            && request.resource.data.year <= 2100
            // derived by the build, never client-supplied
            && !('postedOn' in request.resource.data)
            && !('owner' in request.resource.data)
            && !('featured' in request.resource.data);
      }

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'queued'
                    && request.resource.data.createdAt == request.time
                    && candShapeOk()
                    && request.resource.data.keys().size() <= 30;

      allow read: if isOwner(resource.data.uid) || isAdmin();

      // Correct, or take the profile down; back to 'queued' re-publishes it.
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.status in ['queued', 'withdrawn']
                    && candShapeOk();

      // account merge hand-over — same shape and reasoning as jobSubmissions
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['uid', 'mergedFrom', 'mergedAt'])
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() >= 10
                    && request.resource.data.uid != resource.data.uid
                    && request.resource.data.mergedFrom == request.auth.uid;

      allow delete: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------- placements

    /* A confirmed placement: who, from which PhD, joining where as what.
       Same lifecycle as the other two, no uploads. */
    match /placementSubmissions/{id} {

      function plShapeOk() {
        return str('first', 100)             && str('last', 100)
            && str('phdInstitution', 220)     && str('undergradInstitution', 220)
            && str('joiningInstitution', 220) && str('joiningPosition', 160)
            && str('webUrl', 600)             && str('email', 200)
            && str('note', 1500)              && str('source', 40)
            && str('authEmail', 200)          && str('ref', 60)
            && request.resource.data.year is int
            && request.resource.data.year >= 2000
            && request.resource.data.year <= 2100
            && !('postedOn' in request.resource.data)
            && !('owner' in request.resource.data)
            && !('featured' in request.resource.data);
      }

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'queued'
                    && request.resource.data.createdAt == request.time
                    && plShapeOk()
                    && request.resource.data.keys().size() <= 25;

      allow read: if isOwner(resource.data.uid) || isAdmin();

      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.status in ['queued', 'withdrawn']
                    && plShapeOk();

      // account merge hand-over — same shape and reasoning as jobSubmissions
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['uid', 'mergedFrom', 'mergedAt'])
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() >= 10
                    && request.resource.data.uid != resource.data.uid
                    && request.resource.data.mergedFrom == request.auth.uid;

      allow delete: if isAdmin();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ feedback

    match /feedback/{id} {
      // Feedback may be left by ANYONE, signed in or not — the point is to
      // lower the bar for a bug report. Bounded so it cannot be used as free
      // storage: 5 screenshots, and Firestore's own ~1 MB document ceiling.
      // hasOnly() pins the document to the fields the page writes and the
      // mailer reads — before it, any 16 arbitrarily-named keys passed, and
      // `message` was not even required to exist. NOTE the rules language has
      // no per-item predicate for lists, so `shots` is bounded in LENGTH only;
      // the screenshots' data:image shape is enforced where it matters, at
      // render time in oa-feedback.js's inbox (the stored-XSS fix).
      allow create: if str('message', 6000)
                    && str('email', 200)
                    && str('name', 160)
                    && str('ticket', 40)
                    && str('page', 400)
                    && str('ua', 300)
                    && list('shots', 5)
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 5
                    && request.resource.data.status == 'open'
                    && request.resource.data.forwarded == false
                    && request.resource.data.keys().hasOnly(
                         ['ticket', 'message', 'name', 'email', 'shots',
                          'page', 'ua', 'status', 'forwarded', 'createdAt']);

      // The submitter never reads the collection back; only the maintainer does.
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------- accounts data

    // Every account's own private subtree: profile, e-mail alert
    // subscriptions, test-e-mail requests. Nobody else can read it, including
    // other signed-in users. The alerts mailer reads it with the Admin SDK.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    // A contentless public tally so the site can show "N registered users"
    // without exposing the user list. One document per account holding a
    // coarse timestamp and nothing else — no e-mail, no name.
    match /registeredUsers/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['t'])
                            && request.resource.data.t is number;
      // An account may withdraw its OWN mark, and only its own — which is what
      // a merge does with the duplicate it removes, so the tally counts people
      // rather than sign-ins. It can only ever lower the count, never inflate it.
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------------ identity keys
    //
    // How the site notices that one person has two accounts. Each session
    // claims a document per identity it can prove — `orcid:<iD>` and
    // `email:<sha256 of the lowercased address>` — holding a uid and a coarse
    // timestamp. A key already claimed by a DIFFERENT uid is the same person
    // twice, and the site offers to merge them.
    //
    // The e-mail address is HASHED, and reads are `get` only, never `list`:
    // a signed-in visitor can ask "who holds this identity, which I already
    // know" and cannot enumerate the site's users or their addresses. Nobody
    // can claim a key for anyone but themselves, and nothing here grants
    // access to anything — an account's data is still gated on its own uid.
    //
    // A claim CAN be taken over by another signed-in account, and that is
    // deliberate rather than an oversight: it is how the ghost claim left
    // behind by an account that was merged away heals, and how the merge hands
    // the identity to the account being kept. Nothing can be proved here about
    // who really owns an ORCID iD, so the honest statement of what this
    // collection is worth is: a HINT that two accounts belong together, which
    // only ever leads to an offer the user has to answer by signing in to the
    // other account themselves. It is never an authorisation.
    match /accountKeys/{key} {
      allow get: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['uid', 't'])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.t is number;
      allow list, delete: if false;
    }

    // ------------------------------------------------ what's-new overrides
    // The admin curates the public "What's new" list in place (owner,
    // 2026-08-17): one doc per changelog entry id, carrying {hidden: true}
    // and/or an edited {title, summary}. The list is public, so reads are
    // open; only the admin writes. changelog.json stays the source of truth
    // — an override only masks or rewords its entry on the site.
    match /newsOverrides/{id} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.data.keys().hasOnly(['hidden', 'title', 'summary', 't'])
                   && str('title', 300) && str('summary', 2000)
                   && (!('hidden' in request.resource.data)
                       || request.resource.data.hidden is bool)
                   && (!('t' in request.resource.data)
                       || request.resource.data.t is number);
      /* WITHOUT THIS, HIDING AN ENTRY IS A ONE-WAY DOOR. `allow write` cannot
         cover a delete: `request.resource` is null on one, so
         `request.resource.data.keys()` errors and the condition is false. The
         list then filters the hidden entry out for everybody, the maintainer
         included, leaving nothing on the page to press to bring it back — the
         only way out was the Firestore console. (index.html now also shows the
         maintainer what they have hidden, so there is something to press.) */
      allow delete: if isAdmin();
    }

    // ---------------------------------------------- the archives' overrides
    //
    // WHY THIS EXISTS. Three datasets on this site have no write path at all:
    // data/past-postings.json, data/recent-faculty.json and
    // data/universities.json are FROZEN ARCHIVES, written once by
    // _scraper/import-legacy-tables.mjs from Google Sheets and committed —
    // .github/workflows/oa-legacy-import.yml has no schedule. So the pages
    // that render them (previous-markets.html, recent-faculty.html, the map on
    // universities.html) were read-only for everybody, the maintainer
    // included: the only way to correct a school's name or take an old row off
    // the site was to edit a spreadsheet and dispatch a workflow by hand.
    //
    // This is the `newsOverrides` pattern above, generalised: the committed
    // JSON stays the source of truth and an override MASKS or REWORDS one of
    // its rows at read time. The list is public, so reads are open and an
    // override reaches every visitor, not only the maintainer; only the
    // maintainer writes. `dataset` is a field rather than only a doc-id prefix
    // because the pages query by it (a page reads its own dataset's overrides
    // and nothing else).
    //
    // DELIBERATELY NOT AN ADD PATH. An override only ever changes a row that
    // already exists — `rowId` names one. A school the archive does not carry
    // is added upstream, in the Google Sheet the import reads, because two
    // places that can both create the same row is the parallel bookkeeping
    // build-jobs.mjs warns about, and it rots: the import would later publish
    // the school itself and the site would list it twice.
    match /rowOverrides/{id} {
      allow read: if true;
      allow write: if isAdmin()
                   && id == request.resource.data.dataset + '__' + request.resource.data.rowId
                   && request.resource.data.dataset in
                        ['past-postings', 'recent-faculty', 'universities']
                   && str('dataset', 40) && str('rowId', 200)
                   && request.resource.data.keys().hasOnly([
                        'dataset', 'rowId', 'hidden', 't',
                        // the job-shaped archive (past postings)
                        'institution', 'department', 'school', 'unit', 'type',
                        'country', 'applyBy', 'comments',
                        'adUrl', 'postedAtUrl', 'furtherInfoUrl',
                        'levels', 'characteristics',
                        // recently-hired faculty
                        'name', 'last', 'placement', 'almaMater', 'undergrad', 'webUrl',
                        // the universities map
                        'schoolDept', 'address', 'lat', 'lng', 'mapUrl', 'facultyUrl',
                      ])
                   && str('institution', 220) && str('department', 260)
                   && str('school', 200)      && str('unit', 200)
                   && str('type', 40)         && str('country', 80)
                   && str('applyBy', 400)     && str('comments', 1500)
                   && str('adUrl', 600)       && str('postedAtUrl', 600)
                   && str('furtherInfoUrl', 600)
                   && str('name', 220)        && str('last', 120)
                   && str('placement', 220)   && str('almaMater', 220)
                   && str('undergrad', 220)   && str('webUrl', 600)
                   && str('schoolDept', 320)  && str('address', 320)
                   && str('mapUrl', 600)      && str('facultyUrl', 600)
                   && list('levels', 8)       && list('characteristics', 12)
                   && (!('lat' in request.resource.data)
                       || (request.resource.data.lat is number
                           && request.resource.data.lat >= -90
                           && request.resource.data.lat <= 90))
                   && (!('lng' in request.resource.data)
                       || (request.resource.data.lng is number
                           && request.resource.data.lng >= -180
                           && request.resource.data.lng <= 180))
                   && (!('hidden' in request.resource.data)
                       || request.resource.data.hidden is bool)
                   && (!('t' in request.resource.data)
                       || request.resource.data.t is number);
      allow delete: if isAdmin();
    }

    // --------------------------------------------------- usage (admin-only)
    // Usage telemetry (owner, 2026-08-17): one doc per browsing session —
    // time on site, the links/buttons clicked, and which form FIELDS were
    // touched (never their content) — for signed-in AND anonymous visitors,
    // readable by the admin alone. A signed-in session is pinned to its own
    // uid; an anonymous one writes under a random 'anon:…' id with no auth,
    // which is safe because the doc id embeds the session's random sid (a
    // stranger cannot name another session's doc) and the shape is bounded.
    // Disclosed in the Privacy Policy.
    match /usageSessions/{id} {
      allow create, update: if request.resource.data.uid is string
                    && request.resource.data.sid is string
                    && id == request.resource.data.uid + '__' + request.resource.data.sid
                    && str('email', 200) && str('sid', 80) && str('page', 300)
                    && list('clicks', 400) && list('fields', 300)
                    && ((signedIn() && request.resource.data.uid == request.auth.uid)
                        || request.resource.data.uid.matches('anon:[a-z0-9]+'));
      allow read, delete: if isAdmin();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// ---------------------------------------------------------------------------
// Operations Academia — Firestore security rules.
//
// DEPLOY THESE BEFORE ANNOUNCING ANYTHING. Until they are published, every
// write below is refused and the site's forms report that they are not
// switched on yet (which is the state the code ships in).
//
//     firebase deploy --only firestore:rules --project <project-id>
//
// The governing idea, taken from /lit/: the browser is never trusted with
// anything that decides what gets published. A poster may CREATE a submission
// and may edit or withdraw their OWN, but they cannot set `status` to anything
// except 'queued'/'withdrawn', cannot write someone else's uid onto it, and
// cannot mark it featured. The scheduled build runs with the Admin SDK, which
// bypasses these rules, and re-validates every field again before it reaches a
// served file (v2/_scraper/jobs-model.mjs).
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The maintainer. Keep in sync with ADMIN_EMAIL in v2/assets/oa-firebase.js
    // (that one only decides whether an admin panel is DRAWN; this one is the
    // actual authorisation).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kstouras@gmail.com';
    }

    /* `mergedFrom` records the account a posting was handed over FROM, and the
       scheduled build reads it: a poster who merged their accounts still
       carries the OLD account's owner tag on their published row until it is
       republished, so a withdrawal has to be matched against both
       (`removalSpecs` in _scraper/jobs-model.mjs). That makes the field
       load-bearing, and it is therefore pinned to the merge that writes it —
       the ordinary correct/withdraw path may not introduce or change it.

       Without this, the scoping the build does is defeated by the thing it
       relies on: any signed-in account could look a victim's raw uid up
       through `accountKeys` (readable one-at-a-time to anyone signed in),
       name it as `mergedFrom` on a submission carrying the victim's published
       `ref`, withdraw it, and have the next build take the victim's posting
       off the site. */
    function mergedFromUnchanged() {
      return ('mergedFrom' in request.resource.data) == ('mergedFrom' in resource.data)
          && (!('mergedFrom' in request.resource.data)
              || request.resource.data.mergedFrom == resource.data.mergedFrom);
    }

    function str(field, maxLen) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= maxLen);
    }

    function list(field, maxItems) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is list
            && request.resource.data[field].size() <= maxItems);
    }

    // ---------------------------------------------------------------- jobs

    match /jobSubmissions/{id} {

      function shapeOk() {
        return str('institution', 200) && str('department', 260)
            // school and unit are what the form now asks for separately;
            // `department` is the line they are joined into, and is still what
            // every posting made before the split carries.
            && str('school', 200)      && str('unit', 200)
            && str('country', 80)      && str('type', 40)
            // the FINAL apply-by and the SUGGESTED (first-review) apply-by —
            // the form's two date questions since 2026-08
            && str('applyByDate', 20)  && str('reviewDate', 20)
            && str('applyByNote', 400)
            && str('comments', 1500)   && str('postedAtUrl', 600)
            && str('adUrl', 600)       && str('ref', 60)
            && str('firstName', 100)   && str('lastName', 100)
            && str('email', 200)       && str('chairName', 160)
            && str('chairEmail', 200)  && str('note', 1500)
            && str('source', 40)       && str('authEmail', 200)
            // the uploaded advert, waiting in Storage for the build to file
            // it into Drive (oa-jobform.js / build-jobs.mjs)
            && str('adUploadPath', 400) && str('adUploadName', 200)
            && str('adUploadType', 100)
            && list('levels', 8)       && list('characteristics', 12)
            && request.resource.data.year is int
            && request.resource.data.year >= 2000
            && request.resource.data.year <= 2100
            // the page's sort key; the build derives it from createdAt and
            // ignores anything on the document — refuse the key so a poster
            // cannot even try to pin their card to the top
            && !('postedOn' in request.resource.data)
            // owner is derived from uid by the build, never client-supplied
            && !('owner' in request.resource.data);
      }

      /* A poster cannot promote their own posting. On CREATE that is simply
         "no featured field". On UPDATE it has to be "featured is UNCHANGED":
         update() merges, so an already-featured posting carries the field into
         every request, and refusing the field outright would make the one
         featured posting the only one its owner could never correct. */
      function featuredUnchanged() {
        return ('featured' in request.resource.data) == ('featured' in resource.data)
            && (!('featured' in request.resource.data)
                || request.resource.data.featured == resource.data.featured);
      }

      // Anyone signed in may post. Identity is pinned to the caller and the
      // status is pinned to 'queued' — the build decides what is published.
      // createdAt is the server clock, never a client-typed value (create
      // only — on an update request.resource.data carries the EXISTING stamp,
      // which rightly stays put): the build treats it as trustworthy (it
      // becomes addedAt, the e-mail alerts' cursor), so a bogus 1e16 or a
      // back-dated value must not exist at all.
      // The key ceiling must clear what the form actually writes: 28 keys
      // always (collect() + ref/uid/authEmail/status/source/createdAt) and 4
      // more when the advert is UPLOADED rather than linked (adUploadPath/
      // Name/Type/Size) — 32 in all. At the old ceiling of 30 exactly the
      // upload case was refused as permission-denied while a link-only
      // posting sailed through. selftest.mjs pins this arithmetic against
      // the form source, so a new field fails the build, not the poster.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'queued'
                    && request.resource.data.createdAt == request.time
                    && shapeOk()
                    && !('featured' in request.resource.data)
                    // the account merge writes this; a new posting never does
                    && !('mergedFrom' in request.resource.data)
                    && request.resource.data.keys().size() <= 34;

      // A poster may read, correct and withdraw their own posting.
      allow read: if isOwner(resource.data.uid) || isAdmin();

      // A poster correcting or withdrawing their own posting. `status` back to
      // 'queued' is what a correction does — including to a posting that had
      // been withdrawn, which is how one is put back.
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.status in ['queued', 'withdrawn']
                    && featuredUnchanged()
                    && mergedFromUnchanged()
                    && shapeOk();

      // MERGING TWO ACCOUNTS hands a posting over to the account its owner is
      // keeping. A posting is a top-level document owned by a `uid` field, so
      // without this the rule above (which pins that field) would strand every
      // posting of a merged-away account: unwithdrawable, uncorrectable, owned
      // by a sign-in that no longer exists.
      //
      // Only the CURRENT owner may hand one over, and `diff().affectedKeys()`
      // pins everything else — the posting itself cannot be edited under cover
      // of a merge, not even by its owner, and `featured` is as untouchable
      // here as it is above. `mergedFrom` records where it came from, so the
      // change is visible in the document rather than inferred.
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['uid', 'mergedFrom', 'mergedAt'])
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() >= 10
                    && request.resource.data.uid != resource.data.uid
                    && request.resource.data.mergedFrom == request.auth.uid;

      allow delete: if isAdmin();

      // The maintainer can hide a posting, feature one, or fix a typo.
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------- candidates

    /* A job-market candidate's own profile: the same lifecycle as a job
       posting (create queued -> the build publishes -> correct or withdraw),
       plus an optional CV upload that lands in Storage (see _storage.rules,
       kind 'candidates') and is filed into Drive by the build, exactly like a
       job advert. `email` is published ONLY when `emailPublic` is true — the
       old sheet published every address, which is the disclosure the rebuild
       retires. `personalEmail` (owner, 2026-08-24) is asked of everyone and
       NEVER published — it is how the maintainer reaches a candidate after
       their school address dies with the affiliation; it is not in
       CANDIDATE_PUBLIC_FIELDS, so it can never reach data/candidates.json.
       The rsUrl / rsUpload* fields are the RETIRED research-summary slot
       (form stopped asking 2026-08-24): kept bounded here because profiles
       filed before that still carry them, and an unbounded legacy key would
       be worse than a bounded one. */
    match /candidateSubmissions/{id} {

      function candShapeOk() {
        return str('first', 100)      && str('last', 100)
            && str('affiliation', 220) && str('position', 160)
            // the affiliation's three parts (owner, 2026-08-24): university,
            // school, department — the form derives `affiliation` from them
            && str('institution', 220) && str('school', 220)
            && str('unit', 220)
            && str('cvUrl', 600)       && str('rsUrl', 600)
            && str('webUrl', 600)      && str('email', 200)
            && str('personalEmail', 200)
            && str('note', 1500)       && str('source', 40)
            && str('authEmail', 200)   && str('ref', 60)
            && str('cvUploadPath', 400) && str('cvUploadName', 200)
            && str('cvUploadType', 100)
            && str('rsUploadPath', 400) && str('rsUploadName', 200)
            && str('rsUploadType', 100)
            && list('researchAreas', 10) && list('informsDays', 10)
            && (!('emailPublic' in request.resource.data)
                || request.resource.data.emailPublic is bool)
            && request.resource.data.year is int
            && request.resource.data.year >= 2000
            && request.resource.data.year <= 2100
            // derived by the build, never client-supplied
            && !('postedOn' in request.resource.data)
            && !('owner' in request.resource.data)
            && !('featured' in request.resource.data);
      }

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'queued'
                    && request.resource.data.createdAt == request.time
                    && candShapeOk()
                    && !('mergedFrom' in request.resource.data)
                    // 34 like jobSubmissions: the three affiliation parts
                    // (2026-08-24) took the form's worst-case key inventory
                    // past the old 30 — the selftest counts it against this
                    && request.resource.data.keys().size() <= 34;

      allow read: if isOwner(resource.data.uid) || isAdmin();

      // Correct, or take the profile down; back to 'queued' re-publishes it.
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.status in ['queued', 'withdrawn']
                    && mergedFromUnchanged()
                    && candShapeOk();

      // account merge hand-over — same shape and reasoning as jobSubmissions
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['uid', 'mergedFrom', 'mergedAt'])
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() >= 10
                    && request.resource.data.uid != resource.data.uid
                    && request.resource.data.mergedFrom == request.auth.uid;

      allow delete: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------- placements

    /* A confirmed placement: who, from which PhD, joining where as what.
       Same lifecycle as the other two, no uploads. */
    match /placementSubmissions/{id} {

      function plShapeOk() {
        return str('first', 100)             && str('last', 100)
            && str('phdInstitution', 220)     && str('undergradInstitution', 220)
            && str('joiningInstitution', 220) && str('joiningPosition', 160)
            && str('webUrl', 600)             && str('email', 200)
            && str('note', 1500)              && str('source', 40)
            && str('authEmail', 200)          && str('ref', 60)
            && request.resource.data.year is int
            && request.resource.data.year >= 2000
            && request.resource.data.year <= 2100
            && !('postedOn' in request.resource.data)
            && !('owner' in request.resource.data)
            && !('featured' in request.resource.data);
      }

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'queued'
                    && request.resource.data.createdAt == request.time
                    && plShapeOk()
                    && !('mergedFrom' in request.resource.data)
                    && request.resource.data.keys().size() <= 25;

      allow read: if isOwner(resource.data.uid) || isAdmin();

      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.status in ['queued', 'withdrawn']
                    && mergedFromUnchanged()
                    && plShapeOk();

      // account merge hand-over — same shape and reasoning as jobSubmissions
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['uid', 'mergedFrom', 'mergedAt'])
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() >= 10
                    && request.resource.data.uid != resource.data.uid
                    && request.resource.data.mergedFrom == request.auth.uid;

      allow delete: if isAdmin();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ feedback

    match /feedback/{id} {
      // Feedback may be left by ANYONE, signed in or not — the point is to
      // lower the bar for a bug report. Bounded so it cannot be used as free
      // storage: 5 screenshots, and Firestore's own ~1 MB document ceiling.
      // hasOnly() pins the document to the fields the page writes and the
      // mailer reads — before it, any 16 arbitrarily-named keys passed, and
      // `message` was not even required to exist. NOTE the rules language has
      // no per-item predicate for lists, so `shots` is bounded in LENGTH only;
      // the screenshots' data:image shape is enforced where it matters, at
      // render time in oa-feedback.js's inbox (the stored-XSS fix).
      allow create: if str('message', 6000)
                    && str('email', 200)
                    && str('name', 160)
                    && str('ticket', 40)
                    && str('page', 400)
                    && str('ua', 300)
                    && list('shots', 5)
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 5
                    && request.resource.data.status == 'open'
                    && request.resource.data.forwarded == false
                    && request.resource.data.keys().hasOnly(
                         ['ticket', 'message', 'name', 'email', 'shots',
                          'page', 'ua', 'status', 'forwarded', 'createdAt']);

      // The submitter never reads the collection back; only the maintainer does.
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------- accounts data

    // Every account's own private subtree: profile, e-mail alert
    // subscriptions, test-e-mail requests. Nobody else can read it, including
    // other signed-in users. The alerts mailer reads it with the Admin SDK.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    // A contentless tally of registered accounts: one document per account
    // holding a coarse timestamp and nothing else — no e-mail, no name. It
    // exists for ONE reader, the Registered-users card on the maintainer's
    // Admin area (a count() aggregate, which needs read permission like any
    // other read). The figure is the maintainer's, not the public's (owner,
    // 2026-08-23) — /lit/ shows its equivalent to everyone, this site does
    // not — so the read is admin-only, and nothing public ever consumed it.
    match /registeredUsers/{uid} {
      allow read: if isAdmin();
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['t'])
                            && request.resource.data.t is number;
      // An account may withdraw its OWN mark, and only its own — which is what
      // a merge does with the duplicate it removes, so the tally counts people
      // rather than sign-ins. It can only ever lower the count, never inflate it.
      allow delete: if isOwner(uid);
    }

    // -------------------------------------------------- the account roster
    //
    // What the maintainer may know about a registered account: a name, an
    // address, and when it was first and last seen. It exists because
    // `registeredUsers` deliberately does NOT carry any of that — it is a
    // contentless tally, and on the sibling /lit/ the same collection is
    // PUBLIC-read, so identity could never be added to it there and the two
    // sites are kept in the same shape. `profiles/{uid}` is owner-only and
    // holds no address at all (the address lives in the Firebase Auth record,
    // which no browser client can read for anyone but itself).
    //
    // It exists for TWO readers, both the maintainer's: the Registered-users
    // roster on the Admin area, and the recipient picker that addresses a
    // message. Nobody else can read it — not other signed-in users, not the
    // public.
    //
    // THE ADDRESS CANNOT BE FORGED. `email` must equal the caller's own
    // verified-or-not auth address (`request.auth.token.email`), the same
    // pin-it-to-the-writer trick `directoryEdits.by` uses, so a roster row
    // says what the account really signs in as rather than whatever its owner
    // typed. `name` is self-reported, exactly as it is everywhere else on the
    // site, and is rendered as text and never as markup.
    //
    // `first` is write-once in practice: the client sends it only on create.
    // A rule cannot express "never raised" without reading the old document,
    // so the roster treats it as the earliest thing it has seen and says
    // "first seen", never "joined" — the true joined date is Firebase Auth's
    // own creationTime, which only the Admin SDK can read.
    //
    // Disclosed in the Privacy Policy.
    match /userDirectory/{uid} {
      // Declared BEFORE the allow statements that call it, for the reason the
      // sibling /lit/ rules hoist isFeedbackAdmin(): a rule calling a function
      // declared after it is not something to leave to chance.
      function rowOk() {
        return request.resource.data.keys().hasOnly(['name', 'email', 'first', 'seen'])
          && str('name', 200) && str('email', 200)
          // THE ADDRESS CANNOT BE FORGED — but it may be ABSENT. A provider
          // sign-in need not carry an e-mail claim at all (ORCID's does not),
          // and demanding one would silently leave exactly those accounts off
          // the roster. So: no address, or the caller's own. Never anyone
          // else's.
          && (!('email' in request.resource.data)
              || request.resource.data.email == request.auth.token.email)
          && request.resource.data.first is number
          && request.resource.data.seen is number;
      }

      // The maintainer reads the whole roster; a person may read the ONE row
      // the site keeps about them, which is also what lets the browser
      // preserve `first` below without the maintainer's permission. A
      // collection-wide query cannot resolve {uid} and so is refused for
      // everyone but the admin.
      allow read: if isAdmin() || isOwner(uid);

      allow create: if isOwner(uid) && rowOk();

      // `first` is WRITE-ONCE: on any later write it must be exactly what is
      // already stored. The browser reads its own row once per session and
      // sends `first` back unchanged; a client that tried to reset it — or to
      // back-date itself in the roster — is refused. (An account can still
      // delete its own row and open a new one, which is inherent in owning it
      // and only ever moves its OWN first-seen date.)
      allow update: if isOwner(uid) && rowOk()
                    && request.resource.data.first == resource.data.first;
      // An account may withdraw its OWN row, and only its own — which is what
      // the merge does with the duplicate it removes, so the roster lists
      // people rather than sign-ins. It mirrors registeredUsers exactly.
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------------------ messages
    //
    // Two-party threads between the maintainer and one account (owner,
    // 2026-08-24). ONE thread per account, keyed on the uid itself, which is
    // what lets a user read their own unread count with a single get() —
    // no query, no composite index — and lets the maintainer list the threads
    // needing an answer with one equality filter.
    //
    // IT IS DELIBERATELY TOP-LEVEL, NOT users/{uid}/messages. Firestore ORs
    // every matching rule, so under the blanket
    // `match /users/{uid}/{document=**} { allow read, write: if isOwner(uid); }`
    // a narrower rule can only ever GRANT more: the owner's blanket write
    // could not be taken away, and a user could forge a message from the
    // maintainer in their own inbox or clear the flag that says they owe a
    // reply. A top-level collection carrying a `uid` field is the shape
    // jobSubmissions already uses, and it is the only one the maintainer can
    // LIST at all.
    //
    // Nothing here is ever published: message bodies stay in Firestore and
    // never reach a file under data/, like feedback and the candidate
    // submissions. Disclosed in the Privacy Policy.
    match /messages/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      // The maintainer owns the thread: opening one, and clearing the flag
      // once the reply has been read.
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['uid', 'lastAt', 'lastFrom', 'needsAdmin', 'userUnread'])
                            && request.resource.data.uid == uid
                            && request.resource.data.lastAt is number
                            && request.resource.data.lastFrom in ['admin', 'user']
                            && request.resource.data.needsAdmin is bool
                            && request.resource.data.userUnread is int
                            && request.resource.data.userUnread >= 0;

      // The owner may do exactly two things, and neither can rewrite history:
      //   1. mark the thread read — `userUnread` to zero and nothing else;
      //   2. record that they have replied — which must say the reply came
      //      FROM them and must raise the maintainer's flag, never lower it.
      // Anything else (a first thread, another field, clearing needsAdmin)
      // is refused, so the queue on the Admin area cannot be emptied by the
      // person who is waiting in it.
      allow update: if isOwner(uid)
                    && (
                      (request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['userUnread'])
                       && request.resource.data.userUnread == 0)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastAt', 'lastFrom', 'needsAdmin'])
                       && request.resource.data.lastFrom == 'user'
                       && request.resource.data.needsAdmin == true
                       && request.resource.data.lastAt is number)
                    );

      allow delete: if isAdmin();

      // One message. `from` is pinned to who is actually writing, so neither
      // side can put words in the other's mouth; the body is bounded; and
      // only the maintainer may edit or retract one, because a thread whose
      // history either party can rewrite is not a record of anything.
      match /items/{itemId} {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if request.resource.data.keys().hasOnly(['from', 'body', 't'])
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 5000
                      && request.resource.data.t is number
                      && (
                        (isAdmin() && request.resource.data.from == 'admin')
                        // A REPLY NEEDS A THREAD TO REPLY TO. Without this an
                        // owner could write unbounded documents under their own
                        // uid that no thread head points at — invisible on the
                        // Admin area, which lists threads, and so an unbounded
                        // write channel nobody would ever see. It also states
                        // in the rules what the panels already promise: only
                        // the maintainer opens a conversation. One billed read
                        // per reply, and a reply is a rare thing.
                        || (isOwner(uid) && request.resource.data.from == 'user'
                            && exists(/databases/$(database)/documents/messages/$(uid)))
                      );
        allow update, delete: if isAdmin();
      }
    }

    // ------------------------------------------------------ identity keys
    //
    // How the site notices that one person has two accounts. Each session
    // claims a document per identity it can prove — `orcid:<iD>` and
    // `email:<sha256 of the lowercased address>` — holding a uid and a coarse
    // timestamp. A key already claimed by a DIFFERENT uid is the same person
    // twice, and the site offers to merge them.
    //
    // The e-mail address is HASHED, and reads are `get` only, never `list`:
    // a signed-in visitor can ask "who holds this identity, which I already
    // know" and cannot enumerate the site's users or their addresses. Nobody
    // can claim a key for anyone but themselves, and nothing here grants
    // access to anything — an account's data is still gated on its own uid.
    //
    // A claim CAN be taken over by another signed-in account, and that is
    // deliberate rather than an oversight: it is how the ghost claim left
    // behind by an account that was merged away heals, and how the merge hands
    // the identity to the account being kept. Nothing can be proved here about
    // who really owns an ORCID iD, so the honest statement of what this
    // collection is worth is: a HINT that two accounts belong together, which
    // only ever leads to an offer the user has to answer by signing in to the
    // other account themselves. It is never an authorisation.
    match /accountKeys/{key} {
      allow get: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['uid', 't'])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.t is number;
      allow list, delete: if false;
    }

    // ------------------------------------------------ what's-new decisions
    // The admin curates the public "What's new" list in place (owner,
    // 2026-08-17, extended 2026-08-18): one doc per changelog entry id,
    // carrying the DECISION about it and, optionally, an edited
    // {title, summary}. The list is public, so reads are open; only the admin
    // writes. changelog.json stays the source of truth for WHAT was announced
    // — a document here only says what has been done about it.
    //
    //   status: 'approved'   published — every visitor sees it
    //   status: 'pending'    not reviewed yet — only the maintainer sees it
    //   status: 'removed'    taken down — it leaves the list entirely
    //
    // NOTHING NEW PUBLISHES ITSELF (owner, 2026-08-18): an entry with NO
    // document here is withheld unless it predates the review gate. That rule
    // lives in assets/oa-news.js — the same file the two pages and the mailer
    // read it through — because absence cannot be expressed in a rule at all.
    // `hidden` is still written, in step with `status`, so a page served from
    // an older cache reads a removal the same way; it is also how the
    // documents written before this gate existed are still understood.
    match /newsOverrides/{id} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.data.keys()
                        .hasOnly(['status', 'hidden', 'title', 'summary', 't'])
                   && str('title', 300) && str('summary', 2000)
                   && (!('status' in request.resource.data)
                       || request.resource.data.status in ['approved', 'pending', 'removed'])
                   && (!('hidden' in request.resource.data)
                       || request.resource.data.hidden is bool)
                   && (!('t' in request.resource.data)
                       || request.resource.data.t is number);
      /* WITHOUT THIS, A DECISION IS A ONE-WAY DOOR. `allow write` cannot cover
         a delete: `request.resource` is null on one, so
         `request.resource.data.keys()` errors and the condition is false. The
         way back from a removal is normally the "Removed updates" panel under
         the list (assets/oa-news.js), which is drawn for the maintainer alone
         — but a delete has to stay possible, or a document written wrongly
         could only be undone from the Firestore console. */
      allow delete: if isAdmin();
    }

    // ---------------------------------------------- the archives' overrides
    //
    // WHY THIS EXISTS. Three datasets on this site have no write path at all:
    // data/past-postings.json, data/recent-faculty.json and
    // data/universities.json are FROZEN ARCHIVES, written once by
    // _scraper/import-legacy-tables.mjs from Google Sheets and committed —
    // .github/workflows/oa-legacy-import.yml has no schedule. So the pages
    // that render them (previous-markets.html, recent-faculty.html, the map on
    // universities.html) were read-only for everybody, the maintainer
    // included: the only way to correct a school's name or take an old row off
    // the site was to edit a spreadsheet and dispatch a workflow by hand.
    //
    // This is the `newsOverrides` pattern above, generalised: the committed
    // JSON stays the source of truth and an override MASKS or REWORDS one of
    // its rows at read time. The list is public, so reads are open and an
    // override reaches every visitor, not only the maintainer; only the
    // maintainer writes. `dataset` is a field rather than only a doc-id prefix
    // because the pages query by it (a page reads its own dataset's overrides
    // and nothing else).
    //
    // DELIBERATELY NOT AN ADD PATH. An override only ever changes a row that
    // already exists — `rowId` names one. A school the archive does not carry
    // is added upstream, in the Google Sheet the import reads, because two
    // places that can both create the same row is the parallel bookkeeping
    // build-jobs.mjs warns about, and it rots: the import would later publish
    // the school itself and the site would list it twice.
    match /rowOverrides/{id} {
      allow read: if true;
      allow write: if isAdmin()
                   && id == request.resource.data.dataset + '__' + request.resource.data.rowId
                   && request.resource.data.dataset in
                        ['past-postings', 'recent-faculty', 'universities']
                   && str('dataset', 40) && str('rowId', 200)
                   && request.resource.data.keys().hasOnly([
                        'dataset', 'rowId', 'hidden', 't',
                        // the job-shaped archive (past postings)
                        'institution', 'department', 'school', 'unit', 'type',
                        'country', 'applyBy', 'comments',
                        'adUrl', 'postedAtUrl', 'furtherInfoUrl',
                        // recently-hired faculty
                        'name', 'last', 'placement', 'almaMater', 'undergrad', 'webUrl',
                        // the universities map
                        'schoolDept', 'address', 'lat', 'lng', 'mapUrl', 'facultyUrl',
                      ])
                   && str('institution', 220) && str('department', 260)
                   && str('school', 200)      && str('unit', 200)
                   && str('type', 40)         && str('country', 80)
                   && str('applyBy', 400)     && str('comments', 1500)
                   && str('adUrl', 600)       && str('postedAtUrl', 600)
                   && str('furtherInfoUrl', 600)
                   && str('name', 220)        && str('last', 120)
                   && str('placement', 220)   && str('almaMater', 220)
                   && str('undergrad', 220)   && str('webUrl', 600)
                   && str('schoolDept', 320)  && str('address', 320)
                   && str('mapUrl', 600)      && str('facultyUrl', 600)
                   && (!('lat' in request.resource.data)
                       || (request.resource.data.lat is number
                           && request.resource.data.lat >= -90
                           && request.resource.data.lat <= 90))
                   && (!('lng' in request.resource.data)
                       || (request.resource.data.lng is number
                           && request.resource.data.lng >= -180
                           && request.resource.data.lng <= 180))
                   && (!('hidden' in request.resource.data)
                       || request.resource.data.hidden is bool)
                   && (!('t' in request.resource.data)
                       || request.resource.data.t is number);
      allow delete: if isAdmin();
    }

    // ------------------------------------- the Universities directory's edits
    // universities.html's card directory (data/directory.json) is a BUILT
    // file, and this collection is its read-time overlay — the rowOverrides
    // pattern above with the write opened from the maintainer to EVERY
    // REGISTERED USER (owner, 2026-08-24: "allow admin or any registered user
    // to edit it"). A document is keyed on the row it corrects; `add: true`
    // marks a row a user contributed whole (a department no source carries
    // yet). Every write must carry its author (`by` — pinned to the writing
    // account, so attribution cannot be forged onto someone else's uid) and
    // is shown on the card as "Last edited by <name> on <date>".
    //
    // What stays THE MAINTAINER'S ALONE: `hidden` (taking a row off the page
    // — the duplicate half of a merge) and delete (resetting an edit back to
    // the committed file). Both one-way doors otherwise; and without the
    // separate `allow delete`, reset would be impossible at all —
    // request.resource is null on a delete, so an `allow write` condition
    // errors and evaluates false (the newsOverrides lesson).
    match /directoryEdits/{id} {
      allow read: if true;
      allow create, update: if signedIn()
                   && id == request.resource.data.rowId
                   && request.resource.data.by == request.auth.uid
                   && request.resource.data.keys().hasOnly([
                        'rowId', 'add', 'hidden', 'by', 'name', 't',
                        'institution', 'school', 'department', 'type',
                        'country', 'deptUrl', 'facultyUrl',
                      ])
                   && str('rowId', 200)
                   && str('institution', 220) && str('school', 200)
                   && str('department', 260)  && str('type', 40)
                   && str('country', 80)      && str('name', 120)
                   && str('deptUrl', 600)     && str('facultyUrl', 600)
                   && (!('add' in request.resource.data)
                       || request.resource.data.add is bool)
                   && (!('t' in request.resource.data)
                       || request.resource.data.t is number)
                   && (!('hidden' in request.resource.data)
                       || (request.resource.data.hidden is bool && isAdmin()));
      allow delete: if isAdmin();
    }

    // -------------------------------------------- the job review queue
    // Postings crawled from the maintainer's tracking sheet, held back until
    // they are approved. UNLIKE rowOverrides above, this is NOT public-read:
    // a queued posting is by definition not yet public, and data/ is served to
    // anyone who asks, which is exactly why the queue lives here instead of in
    // a committed file. The maintainer reads and writes it; nobody else can do
    // either. The pipeline writes through the Admin SDK, which is not subject
    // to these rules.
    match /jobReviews/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && id == request.resource.data.rowId
                   && str('rowId', 200)
                   && request.resource.data.status in
                        ['pending', 'approved', 'rejected']
                   && request.resource.data.keys().hasOnly([
                        'rowId', 'status', 'row', 'edits',
                        'queuedAt', 'reviewedAt', 'mailedAt', 'note', 'dup', 'biz', 'ad',
                      ])
                   && str('queuedAt', 40) && str('reviewedAt', 40)
                   && str('mailedAt', 40) && str('note', 1000)
                   && (!('row' in request.resource.data)
                       || request.resource.data.row is map)
                   // the possible-duplicate flags the sheet sync computes;
                   // the panel only reads them
                   && (!('dup' in request.resource.data)
                       || request.resource.data.dup is list)
                   // the business-school flag the sync computes — a map, or
                   // null when the sync has cleared it; the panel only reads it
                   && (!('biz' in request.resource.data)
                       || request.resource.data.biz == null
                       || request.resource.data.biz is map)
                   // what the posting's own advertisement says, written by
                   // adverts-verify.mjs; the panel only reads it
                   && (!('ad' in request.resource.data)
                       || request.resource.data.ad == null
                       || request.resource.data.ad is map)
                   && (!('edits' in request.resource.data)
                       || (request.resource.data.edits is map
                           && request.resource.data.edits.keys().hasOnly([
                                'institution', 'department', 'school', 'unit',
                                'type', 'levels', 'country',
                                'applyBy', 'applyByDate', 'reviewDate', 'comments',
                                'adUrl', 'postedAtUrl', 'furtherInfoUrl',
                              ])));
      allow delete: if isAdmin();
    }

    // ------------------------------------------- name-correction suggestions
    // A signed-in poster who spots a university, school or department name the
    // site publishes WRONGLY can suggest the correction from the posting form
    // (assets/oa-namefix.js). NOTHING RENAMES ITSELF: status is pinned to
    // 'pending' on create, only the maintainer decides (admin-area.html), and
    // the data build applies the APPROVED ones — writing them into the served
    // data/name-fixes.json and renaming every posting and vocabulary entry
    // that carries the old spelling. The same "the browser is never trusted
    // with what gets published" rule as jobSubmissions.
    //
    // The maintainer's update may also reword `to` (correcting the correction
    // before approving it); `kind`, `from` and the suggester's identity are
    // part of what was suggested and stay as filed — hence the tighter
    // affectedKeys() on update rather than a plain isAdmin() write.
    match /nameFixes/{id} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.kind in ['institution', 'school', 'unit']
                    && request.resource.data.from is string
                    && request.resource.data.from.size() >= 2
                    && request.resource.data.to is string
                    && request.resource.data.to.size() >= 2
                    && str('from', 200)        && str('to', 200)
                    && str('institution', 200) && str('note', 1000)
                    && str('authEmail', 200)
                    && request.resource.data.keys().hasOnly(
                         ['kind', 'from', 'to', 'institution', 'note',
                          'uid', 'authEmail', 'status', 'createdAt']);

      // the suggester may read their own suggestion back; the maintainer all
      allow read: if isOwner(resource.data.uid) || isAdmin();

      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'to', 'institution',
                                                  'note', 'reviewedAt'])
                    && request.resource.data.status in
                         ['pending', 'approved', 'rejected']
                    && str('to', 200) && str('institution', 200)
                    && str('note', 1000) && str('reviewedAt', 40);

      allow delete: if isAdmin();
    }

    // --------------------------------------------------- usage (admin-only)
    // Usage telemetry (owner, 2026-08-17): one doc per browsing session —
    // time on site, the links/buttons clicked, and which form FIELDS were
    // touched (never their content) — for signed-in AND anonymous visitors,
    // readable by the admin alone. A signed-in session is pinned to its own
    // uid; an anonymous one writes under a random 'anon:…' id with no auth,
    // which is safe because the doc id embeds the session's random sid (a
    // stranger cannot name another session's doc) and the shape is bounded.
    // Disclosed in the Privacy Policy.
    match /usageSessions/{id} {
      allow create, update: if request.resource.data.uid is string
                    && request.resource.data.sid is string
                    && id == request.resource.data.uid + '__' + request.resource.data.sid
                    && str('email', 200) && str('sid', 80) && str('page', 300)
                    && list('clicks', 400) && list('fields', 300)
                    && ((signedIn() && request.resource.data.uid == request.auth.uid)
                        || request.resource.data.uid.matches('anon:[a-z0-9]+'));
      allow read, delete: if isAdmin();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
